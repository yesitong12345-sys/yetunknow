# Cloud studio. In production all three values are required and the site fails closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SITE_OWNER_USER_ID=
# Server-only and used only by the isolated anonymous-message gateway.
# Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI configuration. Never prefix these with NEXT_PUBLIC_.
# Rotate any key that has ever been pasted into a chat or committed.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
